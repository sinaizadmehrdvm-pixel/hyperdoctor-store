  "releaseDecision": "MERGE_ONLY_AFTER_GREEN_CI",
  "scope": {
    "visualEditorUx": true,
    "renderSafety": true,
    "secureDraftPreview": true,
    "fourLanguageAdminUx": true,
    "catalogData": false,
    "pricing": false,
    "inventory": false,
    "automaticPublishing": false,
    "databaseMigration": false
