generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Vertical {
  MEDICAL_EQUIPMENT
  RESPIRATORY_SERVICES
  DENTAL
  VETERINARY
  PHARMACY
  NURSING
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  FAILED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentGateway {
  ZARINPAL
  IDPAY
  MANUAL
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  SUPPORT
  SALES
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  REPLACED
}

enum TaxonomyDimension {
  REGULATORY_CLASSIFICATION
  MEDICAL_SPECIALTY
  CLINICAL_APPLICATION
  INTENDED_USE
  CARE_SETTING
  PRODUCT_TYPE
  PRODUCT_TECHNOLOGY
  COLLECTION
  COMPATIBILITY
}

model Category {
  id                   String                     @id @default(cuid())
  vertical             Vertical
  slug                 String                     @unique
  nameFa               String
  nameTr               String                     @default("")
  nameEn               String
  nameAr               String                     @default("")
  descriptionFa        String                     @default("")
  descriptionTr        String                     @default("")
  descriptionEn        String                     @default("")
  descriptionAr        String                     @default("")
  image                String?
  order                Int                        @default(0)
  isPublished          Boolean                    @default(true)
  parentId             String?
  parent               Category?                  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children             Category[]                 @relation("CategoryToCategory")
  products             Product[]
  secondaryMemberships ProductSecondaryCategory[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([vertical])
  @@index([parentId])
}

model Brand {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String    @unique
  description String    @default("")
  logoUrl     String    @default("")
  websiteUrl  String    @default("")
  isPublished Boolean   @default(true)
  products    Product[] @relation("ProductBrand")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                   String                     @id @default(cuid())
  vertical             Vertical
  categoryId           String
  category             Category                   @relation(fields: [categoryId], references: [id])
  brandId              String?
  brandEntity          Brand?                     @relation("ProductBrand", fields: [brandId], references: [id], onDelete: SetNull)
  slug                 String                     @unique
  nameFa               String
  nameTr               String                     @default("")
  nameEn               String
  nameAr               String                     @default("")
  descriptionFa        String                     @default("")
  descriptionTr        String                     @default("")
  descriptionEn        String                     @default("")
  descriptionAr        String                     @default("")
  brand                String                     @default("")
  modelNumber          String                     @default("")
  sku                  String                     @unique
  barcode              String                     @default("")
  gtin                 String                     @default("")
  manufacturer         String                     @default("")
  countryOfOrigin      String                     @default("")
  price                Int
  compareAtPrice       Int?
  costPrice            Int?
  stock                Int                        @default(0)
  lowStockThreshold    Int                        @default(2)
  minOrderQty          Int                        @default(1)
  maxOrderQty          Int?
  weightGrams          Int?
  lengthMm             Int?
  widthMm              Int?
  heightMm             Int?
  warrantyMonths       Int?
  specs                String                     @default("{}")
  tags                 String                     @default("[]")
  rentalEligible       Boolean                    @default(false)
  professionalUse      Boolean                    @default(false)
  homeUse              Boolean                    @default(true)
  images               Media[]
  variants             ProductVariant[]
  isPublished          Boolean                    @default(false)
  isFeatured           Boolean                    @default(false)
  isNewArrival         Boolean                    @default(false)
  seoTitleFa           String                     @default("")
  seoTitleTr           String                     @default("")
  seoTitleEn           String                     @default("")
  seoTitleAr           String                     @default("")
  seoDescriptionFa     String                     @default("")
  seoDescriptionTr     String                     @default("")
  seoDescriptionEn     String                     @default("")
  seoDescriptionAr     String                     @default("")
  orderItems           OrderItem[]
  wishlistItems        WishlistItem[]
  reviews              Review[]
  warranties           WarrantyRegistration[]
  secondaryCategories  ProductSecondaryCategory[]
  taxonomyLinks        ProductTaxonomy[]
  relationsOutgoing    ProductRelation[]          @relation("ProductRelationSource")
  relationsIncoming    ProductRelation[]          @relation("ProductRelationTarget")
  rentalRequests       RentalRequest[]
  attributeValues      ProductAttributeValue[]
  collectionMemberships CollectionProduct[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([vertical])
  @@index([categoryId])
  @@index([brandId])
  @@index([isPublished, isFeatured])
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  sku            String      @unique
  price          Int?
  compareAtPrice Int?
  stock          Int         @default(0)
  attributes     String      @default("{}")
  isPublished    Boolean     @default(true)
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([productId])
}

model ProductSecondaryCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
}

model TaxonomyTerm {
  id            String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  dimension     TaxonomyDimension
  slug          String
  nameFa        String            @default("")
  nameTr        String            @default("")
  nameEn        String            @default("")
  nameAr        String            @default("")
  descriptionFa String            @default("")
  descriptionTr String            @default("")
  descriptionEn String            @default("")
  descriptionAr String            @default("")
  sortOrder     Int               @default(0)
  isPublished   Boolean           @default(true)
  productLinks  ProductTaxonomy[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now())

  @@unique([dimension, slug])
  @@index([dimension, isPublished, sortOrder])
}

model ProductTaxonomy {
  productId String
  termId    String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  term      TaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@id([productId, termId])
  @@index([termId])
}

model ProductRelation {
  productId        String
  relatedProductId String
  relationType     String
  sortOrder        Int      @default(0)
  product          Product  @relation("ProductRelationSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   Product  @relation("ProductRelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@id([productId, relatedProductId, relationType])
  @@index([relatedProductId])
}

model ProductAttributeDefinition {
  id           String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  code         String                  @unique
  nameFa       String                  @default("")
  nameTr       String                  @default("")
  nameEn       String                  @default("")
  nameAr       String                  @default("")
  groupFa      String                  @default("")
  groupTr      String                  @default("")
  groupEn      String                  @default("")
  groupAr      String                  @default("")
  dataType     String                  @default("TEXT")
  unit         String                  @default("")
  options      Json                    @default("[]") @db.JsonB
  isComparable Boolean                 @default(true)
  isFilterable Boolean                 @default(false)
  isPublished  Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  values       ProductAttributeValue[]
  createdAt    DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                @default(now()) @db.Timestamptz(6)

  @@index([isPublished, sortOrder])
}

model ProductAttributeValue {
  productId    String
  definitionId String
  valueText    String?
  valueNumber  Decimal?
  valueBoolean Boolean?
  product      Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  definition   ProductAttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  createdAt    DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                   @default(now()) @db.Timestamptz(6)

  @@id([productId, definitionId])
  @@index([definitionId])
}

model Collection {
  id               String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  slug             String              @unique
  titleFa          String              @default("")
  titleTr          String              @default("")
  titleEn          String              @default("")
  titleAr          String              @default("")
  descriptionFa    String              @default("")
  descriptionTr    String              @default("")
  descriptionEn    String              @default("")
  descriptionAr    String              @default("")
  heroImageUrl     String              @default("")
  seoTitleFa       String              @default("")
  seoTitleTr       String              @default("")
  seoTitleEn       String              @default("")
  seoTitleAr       String              @default("")
  seoDescriptionFa String              @default("")
  seoDescriptionTr String              @default("")
  seoDescriptionEn String              @default("")
  seoDescriptionAr String              @default("")
  isPublished      Boolean             @default(false)
  sortOrder        Int                 @default(0)
  products         CollectionProduct[]
  createdAt        DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @db.Timestamptz(6)

  @@index([isPublished, sortOrder])
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  @@id([collectionId, productId])
  @@index([productId])
}

model Service {
  id              String           @id @default(cuid())
  vertical        Vertical
  slug            String           @unique
  nameFa          String
  nameTr          String           @default("")
  nameEn          String
  nameAr          String           @default("")
  descriptionFa   String           @default("")
  descriptionTr   String           @default("")
  descriptionEn   String           @default("")
  descriptionAr   String           @default("")
  image           String?
  price           Int?
  priceIsFrom     Boolean          @default(true)
  durationMinutes Int?
  requiresBooking Boolean          @default(true)
  isPublished     Boolean          @default(false)
  orderItems      OrderItem[]
  bookings        ServiceBooking[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([vertical])
}

model ServiceBooking {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestToken  String                    @unique @db.Uuid
  serviceId     String
  customerId    String?
  customerName  String
  phone         String
  email         String?
  preferredDate DateTime                  @db.Date
  preferredTime String
  address       String?
  notes         String?
  locale        String                    @default("fa")
  status        String                    @default("PENDING")
  service       Service                   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer      Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  report        RespiratoryServiceReport?
  createdAt     DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                  @default(now()) @db.Timestamptz(6)

  @@index([serviceId, createdAt])
  @@index([status, createdAt])
  @@index([customerId])
}

model RespiratoryServiceReport {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId             String         @unique @db.Uuid
  reportType            String
  studyDate             DateTime?      @db.Date
  heightCm              Decimal?
  weightKg              Decimal?
  bmi                   Decimal?
  ahi                   Decimal?
  odi                   Decimal?
  avgSpo2               Decimal?
  minSpo2               Decimal?
  t90Minutes            Decimal?
  totalRecordingMinutes Decimal?
  cpapPressure          Decimal?
  ipap                  Decimal?
  epap                  Decimal?
  leakLpm               Decimal?
  maskType              String         @default("")
  deviceModel           String         @default("")
  deviceSerial          String         @default("")
  findings              String         @default("")
  recommendation        String         @default("")
  technicianName        String         @default("")
  physicianName         String         @default("")
  status                String         @default("DRAFT")
  finalizedAt           DateTime?      @db.Timestamptz(6)
  booking               ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt             DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime       @default(now()) @db.Timestamptz(6)
}

model RentalRequest {
  id                 String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  requestToken       String   @unique @db.Uuid
  productId          String
  customerName       String
  phone              String
  email              String?
  preferredStartDate DateTime? @db.Date
  preferredEndDate   DateTime? @db.Date
  address            String?
  notes              String?
  locale             String   @default("fa")
  status             String   @default("NEW")
  adminNotes         String?
  product            Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @db.Timestamptz(6)

  @@index([productId, createdAt])
  @@index([status, createdAt])
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleFa     String
  titleTr     String   @default("")
  titleEn     String
  titleAr     String   @default("")
  contentFa   String   @default("")
  contentTr   String   @default("")
  contentEn   String   @default("")
  contentAr   String   @default("")
  template    String   @default("default")
  isPublished Boolean  @default(false)
  showInNav   Boolean  @default(false)
  navOrder    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  url       String
  altFa     String   @default("")
  altTr     String   @default("")
  altEn     String   @default("")
  altAr     String   @default("")
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Customer {
  id                String           @id @default(cuid())
  email             String?          @unique
  phone             String?          @unique
  passwordHash      String           @default("")
  fullName          String           @default("")
  locale            String           @default("fa")
  isActive          Boolean          @default(true)
  marketingConsent  Boolean          @default(false)
  addresses         Address[]
  orders            Order[]
  wishlistItems     WishlistItem[]
  reviews           Review[]
  couponRedemptions CouponRedemption[]
  tickets           SupportTicket[]
  warranties        WarrantyRegistration[]
  serviceBookings   ServiceBooking[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("")
  fullName   String   @default("")
  phone      String   @default("")
  country    String   @default("")
  province   String   @default("")
  city       String
  address    String
  postalCode String   @default("")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([productId])
}

model Review {
  id         String       @id @default(cuid())
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  title      String       @default("")
  body       String       @default("")
  status     ReviewStatus @default(PENDING)
  isVerified Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([productId, status])
}

model Coupon {
  id                String             @id @default(cuid())
  code              String             @unique
  type              DiscountType
  value             Int
  minOrderAmount    Int?
  maxDiscount       Int?
  usageLimit        Int?
  usageLimitPerUser Int?
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean            @default(true)
  orders            Order[]
  redemptions       CouponRedemption[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model CouponRedemption {
  id         String    @id @default(cuid())
  couponId   String
  customerId String?
  orderId    String?
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([couponId])
  @@index([customerId])
}

model Order {
  id                   String             @id @default(cuid())
  orderNumber          String             @unique
  customerId           String?
  customer             Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  couponId             String?
  coupon               Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponRedemption     CouponRedemption[]
  customerName         String
  phone                String
  email                String?
  address              String
  province             String             @default("")
  city                 String
  country              String             @default("")
  postalCode           String?
  notes                String             @default("")
  locale               String             @default("fa")
  currency             String             @default("IRT")
  items                OrderItem[]
  subtotal             Int
  discountAmount       Int                @default(0)
  shippingFee          Int                @default(0)
  total                Int
  status               OrderStatus        @default(PENDING_PAYMENT)
  gateway              PaymentGateway     @default(ZARINPAL)
  paymentAuthority     String?            @unique
  paymentRefId         String?
  requestToken         String?            @db.Uuid
  checkoutToken        String?            @db.Uuid
  resultToken          String?            @db.Uuid
  reservationExpiresAt DateTime?
  shippingMethod       String             @default("")
  trackingCode         String             @default("")
  shippedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([customerId])
  @@index([status, createdAt])
  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id                        String          @id @default(cuid())
  orderId                   String
  order                     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId                 String?
  product                   Product?        @relation(fields: [productId], references: [id])
  variantId                 String?
  variant                   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  serviceId                 String?
  service                   Service?        @relation(fields: [serviceId], references: [id])
  nameSnapshot              String
  priceSnapshot             Int
  variantSkuSnapshot        String          @default("")
  variantAttributesSnapshot String          @default("{}")
  quantity                  Int             @default(1)
  preferredDate             DateTime?

  @@index([productId, orderId])
  @@index([variantId])
}

model SupportTicket {
  id         String          @id @default(cuid())
  ticketNo   String          @unique
  customerId String?
  customer   Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subject    String
  category   String          @default("")
  status     TicketStatus    @default(OPEN)
  priority   TicketPriority  @default(NORMAL)
  messages   TicketMessage[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status, updatedAt])
}

model TicketMessage {
  id            String        @id @default(cuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType    String
  senderName    String        @default("")
  body          String
  attachmentUrl String        @default("")
  createdAt     DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model WarrantyRegistration {
  id           String          @id @default(cuid())
  serialNumber String          @unique
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  orderId      String?
  orderNumber  String          @default("")
  purchaseDate DateTime?
  startsAt     DateTime
  expiresAt    DateTime
  status       WarrantyStatus  @default(ACTIVE)
  notes        String          @default("")
  events       WarrantyEvent[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([productId])
  @@index([customerId])
}

model WarrantyEvent {
  id          String               @id @default(cuid())
  warrantyId  String
  warranty    WarrantyRegistration @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String               @default("")
  createdAt   DateTime             @default(now())

  @@index([warrantyId, createdAt])
}

model SiteBanner {
  id             String   @id @default(cuid())
  key            String   @unique
  titleFa        String   @default("")
  titleTr        String   @default("")
  titleEn        String   @default("")
  titleAr        String   @default("")
  subtitleFa     String   @default("")
  subtitleTr     String   @default("")
  subtitleEn     String   @default("")
  subtitleAr     String   @default("")
  imageUrl       String   @default("")
  mobileImageUrl String   @default("")
  linkUrl        String   @default("")
  isPublished    Boolean  @default(true)
  order          Int      @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleFa     String
  titleTr     String   @default("")
  titleEn     String   @default("")
  titleAr     String   @default("")
  excerptFa   String   @default("")
  excerptTr   String   @default("")
  excerptEn   String   @default("")
  excerptAr   String   @default("")
  contentFa   String   @default("")
  contentTr   String   @default("")
  contentEn   String   @default("")
  contentAr   String   @default("")
  coverImage  String   @default("")
  category    String   @default("")
  tags        String   @default("[]")
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  role         AdminRole       @default(EDITOR)
  isActive     Boolean         @default(true)
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model AdminSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([adminId])
  @@index([expiresAt])
}

model AdminBootstrap {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
}

model AdminLoginAttempt {
  id        BigInt   @id @default(autoincrement())
  email     String
  success   Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([email, createdAt])
}

model AdminAuditLog {
  id         String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  adminId    String?
  actorName  String     @default("")
  actorEmail String     @default("")
  actorRole  String     @default("")
  action     String
  entity     String     @default("")
  entityId   String?
  details    Json       @default("{}") @db.JsonB
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
}

model SiteSetting {
  id               Int      @id @default(1)
  holdingName      String   @default("VITALIS Group")
  holdingLogoUrl   String   @default("")
  subBrandName     String   @default("Hyper Doctor")
  subBrandLogoUrl  String   @default("")
  contactPhone     String   @default("")
  contactEmail     String   @default("")
  address          String   @default("")
  instagramUrl     String   @default("")
  telegramUrl      String   @default("")
  whatsappUrl      String   @default("")
  defaultLocale    String   @default("fa")
  supportedLocales String   @default("fa,tr,en,ar")
  currency         String   @default("IRT")
  businessTimeZone String   @default("Asia/Tehran")
  updatedAt        DateTime @updatedAt
}
