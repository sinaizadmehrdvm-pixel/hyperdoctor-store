DATABASE_URL="file:./dev.db"

# Public site URL, used to build the Zarinpal callback URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production: https://hyperdoctor.ir

# Persistent media storage. Required in production; never expose the service-role key
# to browser code or prefix it with NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Zarinpal payment gateway
# Sandbox is on by default for local dev — set ZARINPAL_SANDBOX=false and a real
# ZARINPAL_MERCHANT_ID before going live.
ZARINPAL_SANDBOX="true"
ZARINPAL_MERCHANT_ID="zarinpal-sandbox"

# Admin session secret — generate a real random value before deploying
# (e.g. `openssl rand -base64 32`)
AUTH_SECRET="replace-with-a-long-random-value"

# Required when self-hosting behind a reverse proxy / non-default port so
# Auth.js trusts the incoming Host header. Keep true for self-hosted deploys.
AUTH_TRUST_HOST="true"

# Optional one-time admin provisioning during `prisma db seed`.
# Leave both unset to avoid creating/updating an admin user.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="مدیر سایت"
