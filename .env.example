# PostgreSQL / Supabase connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Public site URL, used for callbacks and canonical URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Storage (server-side upload only)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"
SUPABASE_STORAGE_BUCKET="product-media"

# Zarinpal payment gateway
# Sandbox is on by default for testing — set ZARINPAL_SANDBOX=false and a real
# ZARINPAL_MERCHANT_ID only when the production payment flow is verified.
ZARINPAL_SANDBOX="true"
ZARINPAL_MERCHANT_ID="zarinpal-sandbox"

# Admin session secret — generate a real random value before deploying
AUTH_SECRET="replace-with-a-long-random-value"
AUTH_TRUST_HOST="true"
